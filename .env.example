# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# MongoDB connection string, including credentials.
# IMPORTANT: the previous credentials were committed to git history and must be
# rotated in MongoDB Atlas (create a new DB user, delete the old one).
MONGODB_URI=mongodb+srv://NEW_USER:NEW_PASSWORD@cluster0.nzlgthi.mongodb.net/?appName=cluster0

# Login credentials for the demo app.
APP_USERNAME=changeme
APP_PASSWORD=change-this-to-a-strong-value
